# Klucz API PKP PLK Otwarte Dane (poziom Basic). Brak = tryb mock.
PKP_API_KEY=

# auto | live | mock — auto wybiera live gdy PKP_API_KEY jest ustawiony
PKP_DATA_SOURCE=auto

# schedule | operations -- co wyznacza LISTĘ połączeń na tablicy.
# `schedule` (domyślnie): lista z rozkładu, realizacja dokłada opóźnienia.
# `operations`: zachowanie sprzed 31.08.2026, lista wyłącznie z realizacji.
# Przełącznik tymczasowy -- do usunięcia nie wcześniej niż ~2026-09-14
# (2 tyg. zdrowego feedu od naprawy 31.08), patrz AGENTS.md #10.
BOARD_SOURCE=schedule

# Interwał pollera w ms (domyślnie 90000 = 90s)
POLL_INTERVAL_MS=90000

# Czas ciszy po którym stacja przestaje być obserwowana (ms, domyślnie 5 min)
INTEREST_TTL_MS=300000

# --- Komunikacja miejska (GTFS) ---
# Wyłącznik całego podprojektu. false = monitor PKP działa sam, nietknięty.
GTFS_ENABLED=true
# Miasta do włączenia, po przecinku (id z rejestru src/lib/gtfs/cities.ts).
GTFS_CITIES=waw
# live | mock — mock nie pobiera nic z sieci. Railway ustawia `live` jawnie.
GTFS_DATA_SOURCE=mock
# Czas bezczynności, po którym rozkład miasta jest zwalniany z pamięci (ms, 1 h).
GTFS_IDLE_TTL_MS=3600000

# Port serwera (ustawiane automatycznie przez Railway)
PORT=3000
